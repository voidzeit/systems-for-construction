{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/review.schema.json",
  "title": "SFC Review",
  "type": "object",
  "required": ["reviewId", "targetId", "decision", "reviewerId", "reviewedAt"],
  "properties": {
    "reviewId": {"type": "string"},
    "targetId": {"type": "string"},
    "decision": {"enum": ["accepted", "rejected", "revoked"]},
    "reviewerId": {"type": "string"},
    "reviewedAt": {"type": "string"},
    "reason": {"type": ["string", "null"]},
    "supersedesReviewId": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
