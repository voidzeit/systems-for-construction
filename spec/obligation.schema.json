{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/obligation.schema.json",
  "title": "SFC Obligation",
  "type": "object",
  "required": [
    "obligationId",
    "requirement",
    "quantifier",
    "population",
    "predicate"
  ],
  "properties": {
    "obligationId": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "$ref": "#/$defs/requirement"
    },
    "quantifier": {
      "enum": [
        "ALL",
        "ANY",
        "NONE",
        "COUNT"
      ]
    },
    "population": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "where": {
          "type": "object"
        },
        "assumptions": {
          "type": "array"
        },
        "minimumExpected": {
          "type": "integer",
          "minimum": 0,
          "description": "How many subjects the requirement presupposes. A smaller population never closes."
        },
        "emptyPopulationPolicy": {
          "enum": [
            "incomplete",
            "not_applicable"
          ],
          "default": "incomplete",
          "description": "Declared meaning of an empty population. It never bypasses the applicability evidence requirement."
        },
        "applicability": {
          "type": "object",
          "properties": {
            "applicable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "basis": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "description": "An empty population may close only when non-applicability is itself evidenced."
        }
      },
      "additionalProperties": true
    },
    "predicate": {
      "type": "object",
      "required": [
        "property",
        "operator",
        "value"
      ],
      "properties": {
        "property": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "==",
            "!=",
            ">=",
            ">",
            "<=",
            "<"
          ]
        },
        "value": {},
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit the requirement is written in. Without it the predicate value is dimensionless and may only be compared against an observation that is also dimensionless."
        }
      },
      "additionalProperties": false
    },
    "requiredEvidence": {
      "type": "boolean"
    },
    "ruleSetVersion": {
      "type": "string"
    },
    "measurement": {
      "type": "object",
      "properties": {
        "assumeObservedUnit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit to assume when an observation declares none. Recorded as an assumption on the determination."
        },
        "assumptionBasis": {
          "type": [
            "string",
            "null"
          ]
        },
        "relativeTolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Explicit policy for unresolved measurements. Absent means no assumption is permitted."
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "requirementId",
        "title",
        "statement"
      ],
      "properties": {
        "requirementId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
