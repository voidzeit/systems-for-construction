{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/event.schema.json",
  "title": "SFC Event",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "aggregateId"],
  "properties": {
    "eventId": {"type": "string"},
    "eventType": {"type": "string"},
    "occurredAt": {"type": "string"},
