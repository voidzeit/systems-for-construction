{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/proof.schema.json",
  "title": "SFC Proof",
  "description": "A structured, auditable proof object derived from admitted evidence.",
  "type": "object",
  "required": [
    "requirementId",
    "population",
    "coverage",
    "claims",
    "evidence",
    "result"
  ],
  "properties": {
    "requirementId": {
      "type": "string"
    },
    "population": {
      "type": "object"
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "claims": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "witnesses": {
      "type": "array"
    },
    "counterexamples": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "result": {
      "enum": [
        "MET",
        "NOT_MET",
        "NOT_APPLICABLE",
        "UNKNOWN",
        "INCOMPLETE",
        "STALE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inspectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence looked at without supporting the conclusion."
    }
  },
  "additionalProperties": false
}
