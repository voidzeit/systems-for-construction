{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/proof.schema.json",
  "title": "SFC Proof",
  "description": "A structured, auditable proof object derived from admitted evidence.",
  "type": "object",
  "required": [
    "requirementId",
    "population",
    "coverage",
    "claims",
    "evidence",
    "result"
  ],
  "properties": {
    "requirementId": {
      "type": "string"
    },
    "population": {
      "type": "object",
      "required": [
        "expected",
        "evaluated"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "claims": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "witnesses": {
      "type": "array"
    },
    "counterexamples": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "result": {
      "enum": [
        "MET",
        "NOT_MET",
        "NOT_APPLICABLE",
        "UNKNOWN",
        "INCOMPLETE",
        "STALE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inspectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence looked at without supporting the conclusion."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "title": "An empty population cannot carry a coverage fraction",
      "description": "Coverage is the fraction of the population that was evaluated. With no established population there is no fraction to state, and a stated one would assert that all of nothing was evaluated.",
      "if": {
        "type": "object",
        "required": [
          "population"
        ],
        "properties": {
          "population": {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "type": "null"
          }
        }
      }
    },
    {
      "title": "A non-empty population must state its coverage",
      "if": {
        "type": "object",
        "required": [
          "population"
        ],
        "properties": {
          "population": {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "type": "number"
          }
        }
      }
    }
  ]
}
