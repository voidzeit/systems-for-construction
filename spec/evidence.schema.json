{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsforconstruction.org/spec/evidence.schema.json",
  "title": "SFC Evidence",
  "type": "object",
  "required": ["evidenceId", "sourceId", "sourceType", "locator", "observedValue", "authority", "confidence", "provenance"],
  "properties": {
    "evidenceId": {"type": "string"},
    "sourceId": {"type": "string"},
    "sourceType": {"enum": ["model_element", "parameter", "schedule_cell", "pdf_page", "pdf_region", "drawing_note", "table", "visual_observation", "external_document", "api_result", "calculated_fact"]},
    "locator": {"type": "object"},
    "observedValue": {},
    "authority": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness": {"type": ["string", "null"]},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "admitted": {"type": "boolean"}
  },
  "additionalProperties": false
}
